# ── General Application Settings ─────────────────────────────────────────────
APP_PORT=8080
APP_ID=
APP_SECRET=
APP_ROOT_HTTP_URL=
DEFAULT_HTTP_PROTOCOL=http
HTTP_PROTOCOL=http

# ── Authentication & Security ─────────────────────────────────────────────────
# SECRET_KEY is used to sign JWT access tokens (HS256).
# Must be at least 32 characters.
SECRET_KEY=
SECRET_KEY_EXPIRATION=3600
REFRESH_SECRET=
REFRESH_SECRET_KEY_EXPIRATION=86400

# SECRET_KEY_FOR_CRYPTO_ENCRYPTION is used to encrypt sensitive region
# credentials (DB password, Redis password, etc.) stored in the database.
# Must be a different value from SECRET_KEY. At least 32 characters.
SECRET_KEY_FOR_CRYPTO_ENCRYPTION=

# ── Email & SMTP Configuration ────────────────────────────────────────────────
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# From-address used for all system emails. Defaults to noreply@auditrakkr.com
MAIL_FROM_ADDRESS=

# ── File Upload Settings ──────────────────────────────────────────────────────
UPLOAD_DIRECTORY=uploads
LOGO_FILE_SIZE_LIMIT=1048576
PHOTO_FILE_SIZE_LIMIT=2097152
GENERAL_FILE_SIZE_LIMIT=5242880

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=tmsdb

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=

# ── Search (Elasticsearch) ────────────────────────────────────────────────────
ES_NODE=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=

# ── Multi-Tenant & Region Settings ───────────────────────────────────────────
DEFAULT_REGION_NAME=
DEFAULT_REGION_ROOT_DOMAIN_NAME=
DEFAULT_REGION_TENANT_COUNT_CAPACITY=100
DEFAULT_REGION_WEBSERVER_HOST=
DEFAULT_REGION_WEBSERVER_PORT=80
DEFAULT_REGION_WEBSERVER_LOGIN=
DEFAULT_REGION_WEBSERVER_PASSWORD=
DEFAULT_ROOT_FILESYSTEM_PATH=/var/www/
DEFAULT_REGION_WEBSERVER_DOMAIN=

# ── Default SMTP for Tenants & Regions ───────────────────────────────────────
DEFAULT_SMTP_USER=
DEFAULT_SMTP_PWORD=
DEFAULT_SMTP_HOST=
DEFAULT_SMTP_PORT=587
DEFAULT_SMTP_SERVICE=
DEFAULT_SMTP_SECURE=false
DEFAULT_SMTP_OAUTH=false
DEFAULT_SMTP_CLIENT_ID=
DEFAULT_SMTP_CLIENT_SECRET=
DEFAULT_SMTP_ACCESS_TOKEN=
DEFAULT_SMTP_REFRESH_TOKEN=
DEFAULT_SMTP_ACCESS_URL=
DEFAULT_SMTP_POOL=false
DEFAULT_SMTP_MAXIMUM_CONNECTIONS=5
DEFAULT_SMTP_MAXIMUM_MESSAGES=100

# ── JWT defaults ──────────────────────────────────────────────────────────────
DEFAULT_JWT_SECRET_KEY_EXPIRATION=3600
DEFAULT_JWT_REFRESH_SECRET_KEY_EXPIRATION=86400
DEFAULT_JWT_SECRET_PRIVATE_KEY=
DEFAULT_JWT_SECRET_PRIVATE_KEY_PASSPHRASE=
DEFAULT_JWT_SECRET_PUBLIC_KEY=
DEFAULT_JWT_SIGN_ALGORITHM=HS256

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# Set DEFAULT_GOOGLE=true to enable the /auth/google routes.
DEFAULT_GOOGLE=false
GOOGLE_API_KEY=
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
GOOGLE_OAUTH2_CLIENT_OIDC_ISSUER=
GOOGLE_OAUTH2_REDIRECT_URI=

# Gmail (for sending mail via Gmail OAuth2 — separate from Google login)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=

# ── Facebook OAuth2 ───────────────────────────────────────────────────────────
# Set DEFAULT_FACEBOOK=true to enable the /auth/facebook routes.
DEFAULT_FACEBOOK=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
CALLBACK_URL=

# ── Feature Toggles ───────────────────────────────────────────────────────────
DEFAULT_TWO_FACTOR=false

# ── UI & Theme Settings ───────────────────────────────────────────────────────
DEFAULT_THEME_CUSTOM=false
DEFAULT_THEME_TYPE=light
DEFAULT_THEME_ROOT_URL=

# ── Email Templates ───────────────────────────────────────────────────────────
# Leave blank to use built-in defaults.
DEFAULT_RESET_PASSWORD_MAIL_OPTION_SETTINGS_TEXT_TEMPLATE_LINE1=
DEFAULT_RESET_PASSWORD_MAIL_OPTION_SETTINGS_TEXT_TEMPLATE_LINE2=
DEFAULT_RESET_PASSWORD_MAIL_OPTION_SETTINGS_TEXT_TEMPLATE_LINE3=
DEFAULT_CONFIRM_EMAIL_MAIL_OPTION_SETTINGS_TEXT_TEMPLATE_LINE1=
DEFAULT_CONFIRM_EMAIL_MAIL_OPTION_SETTINGS_TEXT_TEMPLATE_LINE2=
